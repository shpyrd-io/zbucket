{
  "name": "warehouse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx scripts/dev.ts",
    "start": "next start -p ${PORT:-3000}",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "lint": "oxlint src app scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "worker": "node --env-file-if-exists=.env --import tsx scripts/worker.ts",
    "knowledge:import": "node --env-file-if-exists=.env --import tsx scripts/import-knowledge.ts",
    "test:acceptance": "node --env-file-if-exists=.env --import tsx scripts/acceptance.ts",
    "seed:demo": "node --env-file-if-exists=.env --import tsx scripts/seed-demo.ts",
    "metrics:verify-resolution": "node --env-file-if-exists=.env --import tsx scripts/metrics/verify-resolution.ts",
    "metrics:verify-missing-data": "node --env-file-if-exists=.env --import tsx scripts/metrics/verify-missing-data.ts",
    "metrics:verify-purge": "node --env-file-if-exists=.env --import tsx scripts/metrics/verify-purge.ts",
    "seed:charts": "node --env-file-if-exists=.env --import tsx scripts/seed-chart-gallery.ts"
  },
  "dependencies": {
    "@shpyrd/ui": "file:vendor/shpyrd-ui",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "next": "^16.3.7",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "uuid": "^14.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
